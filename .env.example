# Copy to .env and fill in. Names only here; never commit values.
# Variables are added as each phase needs them (see docs/plan.md).

# Dev Supabase project (Phase 1)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Session pooler connection string; used by the server and by database tests
DATABASE_URL=

# Server-side secret mixed into API key hashes. Changing it invalidates every key.
RETRACK_KEY_PEPPER=

# The deployed server's own restricted database login (transaction pooler, port 6543)
SERVER_DB_PASSWORD=
SERVER_DATABASE_URL=
