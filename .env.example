# Copy to .env and fill in. Names only here; never commit values.
# Variables are added as each phase needs them (see docs/plan.md).

# Dev Supabase project (Phase 1)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Session pooler connection string; used by the server and by database tests
DATABASE_URL=

# Server-side secret mixed into API key hashes. Changing it invalidates every key.
RETRACK_KEY_PEPPER=

# The deployed server's own restricted database login (transaction pooler, port 6543)
SERVER_DB_PASSWORD=
SERVER_DATABASE_URL=

# SDK settings (the smoke-test project's key, created with retrack-admin)
RETRACK_SMOKE_PROJECT_ID=
RETRACK_API_KEY=
RETRACK_BASE_URL=

# Shared secret for /internal/* worker routes (also stored in Supabase Vault)
RETRACK_WORKER_SECRET=

# Retrack's own LLM key (Claude Haiku 5.5). Never used by tests.
ANTHROPIC_API_KEY=
# Turn on Retrack's own LLM (judge). Off unless exactly "true". Spends credits.
RETRACK_LLM_ENABLED=
RETRACK_LLM_MODEL=
RETRACK_LLM_EFFORT=

# Embeddings (Vertex AI). Off unless exactly "true". Spends money.
RETRACK_EMBEDDINGS_ENABLED=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
