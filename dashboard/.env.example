# Copy to .env.local and fill in. Names only here; never commit values.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (safe in the browser; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Same pepper as the API server (root .env); used only on the server to hash new API keys
RETRACK_KEY_PEPPER=
# The Retrack API base URL shown in SDK snippets
NEXT_PUBLIC_RETRACK_API_URL=
